# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Kaggle API token (https://www.kaggle.com/settings → API → Create New Token)
KAGGLE_API_TOKEN=

# Weights & Biases API key (https://wandb.ai/authorize)
WANDB_API_KEY=

# WandB project name (will be created automatically on first run)
WANDB_PROJECT=autoresearch

# RunPod API key (https://www.runpod.io/console/user/settings → API Keys)
RUNPOD_API_KEY=

# RunPod SSH user suffix — found in the "Connect" button on any pod.
# SSH command looks like: ssh {pod_id}-XXXXXXXX@ssh.runpod.io
# Copy the XXXXXXXX part (8 hex chars after the dash in the username).
RUNPOD_SSH_USER_SUFFIX=
